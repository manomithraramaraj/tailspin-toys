---
import type { Category, Publisher } from '../types/game';

interface Props {
    /** Categories offered as combinable game filters. */
    categories: Category[];
    /** Publishers offered as a single-select game filter. */
    publishers: Publisher[];
    /** Number of game cards rendered on the page before filtering. */
    totalGames: number;
}

const { categories, publishers, totalGames } = Astro.props;
---

<section
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
    aria-labelledby="game-filters-heading"
    data-testid="game-filters"
>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 id="game-filters-heading" class="text-xl font-semibold text-slate-100">
                Filter games
            </h2>
            <p class="mt-1 text-sm text-slate-300">
                Choose one or more categories and optionally a publisher.
            </p>
        </div>
        <button
            id="clear-game-filters"
            type="button"
            class="hidden rounded-lg border border-slate-600 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-game-filters"
        >
            Clear all filters
        </button>
    </div>

    <div class="grid gap-5 lg:grid-cols-[2fr_1fr]">
        <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.name}
                            class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            data-testid={`category-filter-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">
                Publisher
            </label>
            <select
                id="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="publisher-filter"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.name}>{publisher.name}</option>
                ))}
            </select>
        </div>
    </div>

    <div id="active-game-filters" class="mt-5 hidden" data-testid="active-game-filters">
        <h3 class="mb-2 text-sm font-semibold text-slate-200">Active filters</h3>
        <ul id="active-game-filter-list" class="flex flex-wrap gap-2"></ul>
    </div>

    <p
        id="game-filter-status"
        class="mt-5 text-sm text-slate-300"
        role="status"
        aria-live="polite"
        data-testid="game-filter-status"
    >
        Showing {totalGames} of {totalGames} games.
    </p>
</section>

<script>
    function requireElement<T extends Element>(selector: string): T {
        const element = document.querySelector<T>(selector);
        if (!element) {
            throw new Error(`Required game filter element not found: ${selector}`);
        }
        return element;
    }

    const filterRoot = requireElement<HTMLElement>('[data-testid="game-filters"]');
    const categoryInputs = Array.from(
        filterRoot.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = requireElement<HTMLSelectElement>('#publisher-filter');
    const clearButton = requireElement<HTMLButtonElement>('#clear-game-filters');
    const activeFilters = requireElement<HTMLElement>('#active-game-filters');
    const activeFilterList = requireElement<HTMLUListElement>('#active-game-filter-list');
    const status = requireElement<HTMLElement>('#game-filter-status');
    const gamesGrid = requireElement<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = requireElement<HTMLElement>('[data-testid="filtered-empty-state"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const knownPublishers = new Set(
        Array.from(publisherSelect.options, (option) => option.value).filter(Boolean),
    );

    let selectedCategories = new Set<string>();
    let selectedPublisher = '';

    function syncUrl(): void {
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        url.searchParams.delete('publisher');

        for (const category of selectedCategories) {
            url.searchParams.append('category', category);
        }
        if (selectedPublisher) {
            url.searchParams.set('publisher', selectedPublisher);
        }

        window.history.replaceState({}, '', url);
    }

    function createFilterChip(type: 'category' | 'publisher', value: string): HTMLLIElement {
        const item = document.createElement('li');
        item.className = 'flex items-center gap-2 rounded-full bg-slate-700 px-3 py-1 text-sm text-slate-100';

        const label = document.createElement('span');
        label.textContent = `${type === 'category' ? 'Category' : 'Publisher'}: ${value}`;
        item.append(label);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'rounded-full px-1 text-slate-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500';
        removeButton.dataset.testid = `remove-${type}-filter`;
        removeButton.setAttribute('aria-label', `Remove ${type} filter ${value}`);
        removeButton.textContent = '\u00d7';
        removeButton.addEventListener('click', () => {
            if (type === 'category') {
                selectedCategories.delete(value);
                const input = categoryInputs.find((candidate) => candidate.value === value);
                if (input) {
                    input.checked = false;
                }
            } else {
                selectedPublisher = '';
                publisherSelect.value = '';
            }
            applyFilters();
        });
        item.append(removeButton);

        return item;
    }

    function renderActiveFilters(): void {
        activeFilterList.replaceChildren();

        for (const category of selectedCategories) {
            activeFilterList.append(createFilterChip('category', category));
        }
        if (selectedPublisher) {
            activeFilterList.append(createFilterChip('publisher', selectedPublisher));
        }

        const hasFilters = selectedCategories.size > 0 || selectedPublisher !== '';
        activeFilters.classList.toggle('hidden', !hasFilters);
        clearButton.classList.toggle('hidden', !hasFilters);
    }

    function applyFilters(updateUrl = true): void {
        let visibleGames = 0;

        for (const card of gameCards) {
            const categoryMatches = selectedCategories.size === 0
                || selectedCategories.has(card.dataset.gameCategory ?? '');
            const publisherMatches = selectedPublisher === ''
                || selectedPublisher === card.dataset.gamePublisher;
            const matches = categoryMatches && publisherMatches;
            card.hidden = !matches;
            if (matches) {
                visibleGames += 1;
            }
        }

        gamesGrid.hidden = visibleGames === 0;
        emptyState.hidden = visibleGames !== 0;
        status.textContent = `Showing ${visibleGames} of ${gameCards.length} games.`;
        renderActiveFilters();

        if (updateUrl) {
            syncUrl();
        }
    }

    function loadFiltersFromUrl(): void {
        const params = new URLSearchParams(window.location.search);
        selectedCategories = new Set(params.getAll('category').filter(Boolean));
        selectedPublisher = params.get('publisher') ?? '';

        for (const input of categoryInputs) {
            input.checked = selectedCategories.has(input.value);
        }
        publisherSelect.value = knownPublishers.has(selectedPublisher) ? selectedPublisher : '';
        applyFilters(false);
    }

    for (const input of categoryInputs) {
        input.addEventListener('change', () => {
            if (input.checked) {
                selectedCategories.add(input.value);
            } else {
                selectedCategories.delete(input.value);
            }
            applyFilters();
        });
    }

    publisherSelect.addEventListener('change', () => {
        selectedPublisher = publisherSelect.value;
        applyFilters();
    });

    clearButton.addEventListener('click', () => {
        selectedCategories.clear();
        selectedPublisher = '';
        for (const input of categoryInputs) {
            input.checked = false;
        }
        publisherSelect.value = '';
        applyFilters();
    });

    window.addEventListener('popstate', loadFiltersFromUrl);
    loadFiltersFromUrl();
</script>
